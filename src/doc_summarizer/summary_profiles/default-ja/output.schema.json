{
  "type": "output-schema",
  "id": "23f553cb-baa6-430f-b9e9-67b5e4254e04",
  "version": "1.0",
  "schema": {
    "$defs": {
      "SummarySection": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "minLength": 1,
            "title": "Heading",
            "type": "string"
          },
          "details": {
            "description": "Direct details used only when a second heading level is unnecessary",
            "items": {
              "type": "string"
            },
            "title": "Details",
            "type": "array"
          },
          "subsections": {
            "description": "Optional H4-level groups below this major H3 section",
            "items": {
              "$ref": "#/$defs/SummarySubsection"
            },
            "title": "Subsections",
            "type": "array"
          }
        },
        "required": [
          "heading",
          "details",
          "subsections"
        ],
        "title": "SummarySection",
        "type": "object"
      },
      "SummarySubsection": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "minLength": 1,
            "title": "Heading",
            "type": "string"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Details",
            "type": "array"
          }
        },
        "required": [
          "heading",
          "details"
        ],
        "title": "SummarySubsection",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "title": {
        "description": "A concise title derived from the complete summarized content",
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "summary": {
        "description": "One compact Japanese paragraph that states the central thesis, essential reasoning, and result without duplicating the detailed structure",
        "minLength": 1,
        "title": "Summary",
        "type": "string"
      },
      "structuring": {
        "items": {
          "$ref": "#/$defs/SummarySection"
        },
        "minItems": 1,
        "title": "Structuring",
        "type": "array"
      },
      "key_points": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Key Points",
        "type": "array"
      },
      "technical_terms": {
        "description": "Important terms formatted in Japanese as Markdown strings in the form '**term**: one or two source-grounded explanatory sentences'",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Technical Terms",
        "type": "array"
      },
      "conclusion": {
        "description": "A source-grounded Japanese conclusion in two or three short paragraphs when warranted, starting with a standalone takeaway used for the note description",
        "minLength": 1,
        "title": "Conclusion",
        "type": "string"
      }
    },
    "required": [
      "title",
      "summary",
      "structuring",
      "key_points",
      "technical_terms",
      "conclusion"
    ],
    "title": "SummaryDocument",
    "type": "object"
  }
}
