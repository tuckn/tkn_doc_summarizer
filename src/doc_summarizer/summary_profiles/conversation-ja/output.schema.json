{
  "type": "output-schema",
  "id": "017fae40-3063-48f9-8d0b-0a50858aeddd",
  "version": "1.0",
  "schema": {
    "$defs": {
      "ConversationEvidence": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "pattern": "^S[1-9][0-9]*$",
            "title": "Source Id",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "speaker_label": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "^[^\\[\\]\\r\\n]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker Label"
          }
        },
        "required": [
          "source_id",
          "start",
          "end",
          "speaker_label"
        ],
        "title": "ConversationEvidence",
        "type": "object"
      },
      "ConversationItem": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "kind": {
            "enum": [
              "statement",
              "hearsay",
              "joke",
              "speculation",
              "wish",
              "plan",
              "commitment"
            ],
            "title": "Kind",
            "type": "string"
          },
          "subject": {
            "description": "Who or what the statement concerns",
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "speaker_name": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker Name"
          },
          "identity_status": {
            "enum": [
              "unknown",
              "inferred",
              "confirmed"
            ],
            "title": "Identity Status",
            "type": "string"
          },
          "identity_basis": {
            "minLength": 1,
            "title": "Identity Basis",
            "type": "string"
          },
          "uncertainty": {
            "minLength": 1,
            "title": "Uncertainty",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/ConversationEvidence"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          }
        },
        "required": [
          "text",
          "kind",
          "subject",
          "speaker_name",
          "identity_status",
          "identity_basis",
          "uncertainty",
          "evidence"
        ],
        "title": "ConversationItem",
        "type": "object"
      },
      "ConversationTopic": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "minLength": 1,
            "title": "Heading",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/ConversationItem"
            },
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "heading",
          "items"
        ],
        "title": "ConversationTopic",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "title": {
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "summary": {
        "description": "Short overview of topics, without analysis",
        "minLength": 1,
        "title": "Summary",
        "type": "string"
      },
      "topics": {
        "items": {
          "$ref": "#/$defs/ConversationTopic"
        },
        "minItems": 1,
        "title": "Topics",
        "type": "array"
      },
      "plans": {
        "items": {
          "$ref": "#/$defs/ConversationItem"
        },
        "title": "Plans",
        "type": "array"
      },
      "unconfirmed": {
        "items": {
          "$ref": "#/$defs/ConversationItem"
        },
        "title": "Unconfirmed",
        "type": "array"
      },
      "limitations": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Limitations",
        "type": "array"
      }
    },
    "required": [
      "title",
      "summary",
      "topics",
      "plans",
      "unconfirmed",
      "limitations"
    ],
    "title": "ConversationDocument",
    "type": "object"
  }
}
